# A simple wrapper for the function builtin, which creates a function wrapping a command
# https://fishshell.com/docs/current/cmds/alias.html

# === START OF CHEZMOI MANAGED ===
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") (lookPath "wl-copy")}}
function cpwd
    printf '%s' "$PWD" | wl-copy
end
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
function cpwd
    printf '%s' "$PWD" | pbcopy
end
{{ end }}
# === END OF CHEZMOI MANAGED ===

{{- if lookPath "gping" }}
alias ping="gping"
{{- else if lookPath "prettyping" }}
alias ping="prettyping --nolegend"
{{- end }}

# custom opencode config
alias oct="env OPENCODE_CONFIG_DIR=$HOME/.config/opencode-thinking opencode"
