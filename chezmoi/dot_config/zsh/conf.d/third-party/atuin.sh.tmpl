{{- if eq .chezmoi.os "linux" -}}
PATH="${HOME}/.atuin/bin/:${PATH}"
{{- end }}

if (( $+commands[atuin] )); then
    if [[ -n ${ZSH_NAME} ]]; then
        _init_atuin_zsh() {
            export ATUIN_NOBIND="true"
            # Create the session id here instead of letting the init script spawn
            # `atuin uuid` (same 32-hex format, version-7 nibble set).
            if [[ -z ${ATUIN_SESSION:-} || ${ATUIN_SHLVL:-} != $SHLVL ]]; then
                printf -v ATUIN_SESSION '%04x%04x%04x7%03x%04x%04x%04x%04x' \
                    $(( RANDOM << 1 ^ RANDOM )) $(( RANDOM << 1 ^ RANDOM )) $(( RANDOM << 1 ^ RANDOM )) \
                    $(( RANDOM % 4096 )) $(( 32768 + RANDOM % 16384 )) \
                    $(( RANDOM << 1 ^ RANDOM )) $(( RANDOM << 1 ^ RANDOM )) $(( RANDOM << 1 ^ RANDOM ))
                export ATUIN_SESSION ATUIN_SHLVL=$SHLVL
            fi
            __cached_source atuin
            bindkey '^[[A' atuin-up-search
            bindkey '^[OA' atuin-up-search
            (( $+widgets[_atuin_search_widget] )) && bindkey '^r' _atuin_search_widget
        }

        if (( $+functions[zsh-defer] )); then
            zsh-defer _init_atuin_zsh
        else
            _init_atuin_zsh
        fi
    elif [[ -n ${BASH} ]]; then
        # shellcheck disable=SC1091
        [[ -f ~/.bash-preexec.sh ]] && source "${HOME}/.bash-preexec.sh"
        eval "$(atuin init bash)"
        bind -x '"\C-r": __atuin_history'
        bind -x '"\e[A": __atuin_history --shell-up-key-binding'
        bind -x '"\eOA": __atuin_history --shell-up-key-binding'
    fi
fi
