{{ if eq .secrets.provider "onepassword" -}}
{{ $apidog_key := onepasswordRead .secrets.apidog.apidog_api_key -}}
{{- if $apidog_key -}}
export APIDOG_ACCESS_TOKEN="{{ $apidog_key }}"
export APIDOG_PROJECT_ID="{{ onepasswordRead .secrets.apidog.apidog_project_id_allweezy_backend }}"
{{ end -}}
{{ $context7 := onepasswordRead .secrets.ai_mcp.context7_apikey -}}
{{- if $context7 -}}
export CONTEXT7_MCP_API_KEY="{{ $context7 }}"
{{ end -}}
{{- $github := "" -}}
{{- if .identity.github_token -}}
{{- $github = onepasswordRead (index .secrets.github .identity.github_token) -}}
{{- end -}}
{{- if $github -}}
export GITHUB_TOKEN="{{ $github }}"
{{ end -}}
{{ $openrouter := onepasswordRead .secrets.ai_inference.openrouter_apikey -}}
{{- if $openrouter -}}
export OPENROUTER_API_KEY="{{ $openrouter }}"
{{ end -}}
{{ $wakatime := onepasswordRead .secrets.productivity.wakatime_apikey -}}
{{- if $wakatime -}}
export WAKATIME_API_KEY="{{ $wakatime }}"
{{- end -}}
{{ $exa := onepasswordRead .secrets.ai_mcp.exa_apikey -}}
{{- if $exa -}}
export EXA_API_KEY="{{ $exa }}"
{{ end -}}
{{ $linear := onepasswordRead .secrets.ai_mcp.linear_apikey -}}
{{- if $linear -}}
export LINEAR_API_KEY="{{ $linear }}"
{{ end -}}
{{ $tavily := onepasswordRead .secrets.ai_mcp.tavily_apikey -}}
{{- if $tavily -}}
export TAVILY_API_KEY="{{ $tavily }}"
{{ end -}}
{{ $ticktick := onepasswordRead .secrets.ai_mcp.ticktick_apikey -}}
{{- if $ticktick -}}
export TICKTICK_API_KEY="{{ $ticktick }}"
{{- end -}}
{{- end }}
