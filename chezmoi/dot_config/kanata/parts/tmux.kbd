;; TMUX layer and aliases.
(defalias
  tmux-prefix C-b

  tx-new-window (macro @tmux-prefix 50 c) ;; New window.
  tx-new-session (macro @tmux-prefix 50 S-s)
  tx-detach (macro @tmux-prefix 50 d) ;; Detach tmux.
  tx-vi-mode (macro @tmux-prefix 50 [) ;; Switch to tmux vi mode.

  ;; rename session/window/pane
  tx-rn-session (macro @tmux-prefix 50 S-4) ;; Rename session.
  tx-rn-window (macro @tmux-prefix 50 ,) ;; Rename window.
  tx-rn-pane (macro @tmux-prefix 50 u) ;; Rename pane.

  ;; switch between last session/window/pane
  tx-sw-session (macro @tmux-prefix 50 S-a)
  tx-sw-window (macro @tmux-prefix 50 a)
  tx-sw-pane (macro @tmux-prefix 50 q)

  ;; split pane
  tx-splitv (macro @tmux-prefix 50 S-\)
  tx-splith (macro @tmux-prefix 50 -)

  ;; select session/window
  tx-slcsession (macro @tmux-prefix 50 s) ;; select session (bootstrap predefined layout), tmux use 'sesh' cli & herdr use 'herdr-plus' plugins
  tx-slcworktree (macro @tmux-prefix 50 w) ;; select worktree, in tmux using 'workmux dashboard' & herdr using native worktree picker

  ;; kill session/window/pane
  tx-kill-session (macro @tmux-prefix 50 g)
  tx-kill-window (macro @tmux-prefix 50 S-7)
  tx-kill-pane (macro @tmux-prefix 50 x)

  ;; switch window to {number}
  tx-wdw-1 (macro @tmux-prefix 50 Digit1)
  tx-wdw-2 (macro @tmux-prefix 50 Digit2)
  tx-wdw-3 (macro @tmux-prefix 50 Digit3)
  tx-wdw-4 (macro @tmux-prefix 50 Digit4)
  tx-wdw-5 (macro @tmux-prefix 50 Digit5)
  tx-wdw-6 (macro @tmux-prefix 50 Digit6)
  tx-wdw-7 (macro @tmux-prefix 50 Digit7)
  tx-wdw-8 (macro @tmux-prefix 50 Digit8)

  ;; pane navigation
  tx-p-left (macro @tmux-prefix 50 h)
  tx-p-bottom (macro @tmux-prefix 50 j)
  tx-p-top (macro @tmux-prefix 50 k)
  tx-p-right (macro @tmux-prefix 50 l)

  ;; resize pane
  tx-rsz-right (macro @tmux-prefix 50 right)
  tx-rsz-left (macro @tmux-prefix 50 left)
  tx-rsz-up (macro @tmux-prefix 50 up)
  tx-rsz-bottom (macro @tmux-prefix 50 down)

  ;; swap pane
  tx-swap-prev (macro @tmux-prefix 50 S-[)
  tx-swap-next (macro @tmux-prefix 50 S-])

  ;; plugins
  tx-flash (macro @tmux-prefix 50 S-f)
)

(deflayer tmux
  🔅  🔆  @mc  @sls  @dtn  @dnd  ◀◀  ▶⏸  ▶▶  🔇  🔉  🔊
  grv  @tx-wdw-1  @tx-wdw-2  @tx-wdw-3  @tx-wdw-4  @tx-wdw-5  @tx-wdw-6  @tx-wdw-7  @tx-wdw-8  9  0  @tx-splith  @tx-splitv  bspc
  lrld  @tx-slcsession  @tx-slcworktree  @tx-detach  XX  XX  XX  @tx-rsz-left  @tx-rsz-bottom  @tx-rsz-up  @tx-rsz-right  @tx-swap-prev  @tx-swap-next  \
  caps  @tx-sw-session  @tx-sw-window  @tx-sw-pane  @tx-flash  XX  @tx-p-left  @tx-p-bottom  @tx-p-top  @tx-p-right  ;  '  ret
  lsft  @tx-kill-session  @tx-kill-window  @tx-kill-pane  @tx-vi-mode  @tx-new-session  @tx-new-window  @tx-rn-session  @tx-rn-window  @tx-rn-pane  /  rsft
  lctl  lmet  lalt  @thl-spc-symbols  ralt  rmet  rctl
)
