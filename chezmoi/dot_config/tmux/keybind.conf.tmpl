# === KEYBINDINGS ===
# Use 'bind' as an alias for 'bind-key'

# -------------------------------------------------------------------
# Prefix
# -------------------------------------------------------------------
unbind C-b
set -g prefix C-a
bind-key C-a send-prefix  # or: bind-key -T prefix C-a send-prefix

# -------------------------------------------------------------------
# Configuration
# -------------------------------------------------------------------
# Reload tmux configuration
bind r source-file $HOME/.config/tmux/tmux.conf \; display-message "Config reloaded"

# Open the active pane's scrollback in Neovim.
bind-key e run-shell -b \
  'scrollback_file=$(mktemp "${TMPDIR:-/tmp}/tmux-scrollback.XXXXXX") || exit; \
   tmux capture-pane -p -S - -E - -t "#{pane_id}" > "$scrollback_file" || exit; \
   tmux display-popup -E -c #{q:client_name} -d #{q:pane_current_path} -w 80% -h 80% \
     /bin/sh -c "nvim \"\$1\" && rm -f \"\$1\"" sh "$scrollback_file"'

# -------------------------------------------------------------------
# Pane management
# -------------------------------------------------------------------
# Split panes in the current directory
unbind %
bind | split-window -h -c '#{pane_current_path}'  # Horizontal split

unbind '"'
bind - split-window -v -c '#{pane_current_path}'  # Vertical split

# Close panes/windows without confirmation
unbind x
bind -N "Close pane without confirmation" -T prefix x kill-pane

unbind &
bind -N "Close window without confirmation" -T prefix & kill-window

# Pane navigation using hjkl (similar to Vim)
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# Switch between panes and display pane numbers
unbind q # unbind 'display-pane' which the default is prefix + q
bind Q display-pane # rebinding 'display-pane' to Q
bind q last-pane # bind q to switch between last-pane

# Resize pane with prefix + arrow keys
bind Left resize-pane -L 5
bind Right resize-pane -R 5
bind Up resize-pane -U 5
bind Down resize-pane -D 5

# -------------------------------------------------------------------
# Window and session management
# -------------------------------------------------------------------
# Create new window in the same working directory as the active pane
bind c new-window -c '#{pane_current_path}'

# Create a new tmux session
bind -N "Create new session" -T prefix S new-session

# Switch between windows
bind a last-window
bind A switch-client -l

# Kill the current session
bind g kill-session

# Keep C-w available for the zsh shell keybind
unbind C-w

