{{- $unified_theme := env "UNIFIED_THEME_CLI" -}}
{{- if eq $unified_theme "" }}{{ $unified_theme = .shell_env.common.UNIFIED_THEME_CLI }}{{ end -}}

onboarding = false

[theme]
  name = "{{ if eq $unified_theme "kanagawa-dragon" }}custom{{ else }}gruvbox{{ end }}"

{{ if eq $unified_theme "kanagawa-dragon" -}}
[theme.custom]
  panel_bg = "#1F1F28"
  surface0 = "#16161D"
  surface1 = "#2A2A37"
  surface_dim = "#363646"
  overlay0 = "#54546D"
  overlay1 = "#727169"
  text = "#DCD7BA"
  subtext0 = "#C8C093"
  accent = "#E6C384"
  mauve = "#957FB8"
  green = "#98BB6C"
  yellow = "#E6C384"
  red = "#C34043"
  blue = "#7E9CD8"
  teal = "#7AA89F"
  peach = "#FFA066"
{{- end }}

[ui]
  confirm_close                     = false
  pane_borders                      = true
  pane_gaps                         = false
  prompt_new_tab_name               = false
  redraw_on_focus_gained            = true
  show_agent_labels_on_pane_borders = true
  sidebar_collapsed_mode            = "hidden"

[keys]
  prefix = "ctrl+a"

  # workspaces (tmux sessions)
  close_workspace  = "prefix+g"
  goto             = "prefix+o"
  new_workspace    = "prefix+shift+s"
  rename_workspace = "prefix+$"
  switch_workspace = "prefix+ctrl+1..9"
  workspace_picker = "prefix+w"

  # tabs (tmux windows)
  close_tab    = "prefix+ampersand"
  new_tab      = "prefix+c"
  next_tab     = "prefix+n"
  previous_tab = "prefix+p"
  rename_tab   = "prefix+comma"
  switch_tab   = "prefix+1..9"

  # panes
  close_pane       = "prefix+x"
  focus_pane_down  = "prefix+j"
  focus_pane_left  = "prefix+h"
  focus_pane_right = "prefix+l"
  focus_pane_up    = "prefix+k"
  last_pane        = "prefix+q"

  # splits
  split_horizontal = "prefix+minus"
  split_vertical   = "prefix+|"

  # reload / resize
  reload_config = "prefix+r"
  resize_mode   = "prefix+R"

  # herdr-only features
  copy_mode      = "prefix+["
  detach         = "prefix+d"
  toggle_sidebar = "prefix+b"
  zoom           = "prefix+z"

  focus_agent = "prefix+alt+1..9"

  [[keys.command]]
    command     = "nathanflurry.jj-workspace.new-tab"
    description = "new jj workspace (in tab)"
    key         = "prefix+a"
    type        = "plugin_action"

  [[keys.command]]
    command     = "nathanflurry.jj-workspace.new"
    description = "new jj workspace"
    key         = "prefix+shift+a"
    type        = "plugin_action"

  [[keys.command]]
    command     = "nathanflurry.jj-workspace.remove"
    description = "remove jj workspace"
    key         = "prefix+shift+d"
    type        = "plugin_action"
