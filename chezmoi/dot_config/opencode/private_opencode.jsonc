{
  "model": "opencode-go/deepseek-v4.1-flash",
  "mcp": {
    "servers": {
      "capacities": {
        "type": "remote",
        "url": "https://api.capacities.io/mcp",
        "headers": {},
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": { "Authorization": "Bearer {env:CONTEXT7_MCP_API_KEY}" },
        "disabled": false
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "headers": {},
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": { "Authorization": "Bearer {env:EXA_API_KEY}" },
        "disabled": false
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "headers": {
          "Authorization": "Bearer {env:LINEAR_API_KEY}"
        },
        "disabled": false
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp",
        "headers": { "Authorization": "Bearer {env:TAVILY_API_KEY}" },
        "disabled": true
      },
      "ticktick": {
        "type": "remote",
        "url": "https://mcp.ticktick.com",
        "headers": { "Authorization": "Bearer {env:TICKTICK_API_KEY}" },
        "disabled": false
      }
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "z-ai/glm-5": {
          "settings": {
            "provider": {
              "order": ["baseten", "z.ai"],
              "allow_fallbacks": false
            }
          }
        }
      },
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
