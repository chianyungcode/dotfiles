{{- $unified_theme := env "UNIFIED_THEME_CLI" -}}
{{- if eq $unified_theme "" }}{{ $unified_theme = .shell_env.common.UNIFIED_THEME_CLI }}{{ end -}}

agent_notes                  = true
exclude_untracked            = false
line_numbers                 = true
menu_bar                     = true
mode                         = "auto"          # auto, split, stack
prompt_save_view_preferences = true
theme                        = "{{ if eq $unified_theme "kanagawa-dragon" }}custom{{ else }}vitesse-black{{ end }}" # any built-in theme id, auto, or custom
transparent_background       = false
watch                        = false
wrap_lines                   = false

{{ if eq $unified_theme "kanagawa-dragon" -}}
[custom_theme]
base = "github-dark-default"
label = "Kanagawa Dragon"
accent = "{{ .theme.kanagawa_dragon.orange }}"
panel = "{{ .theme.kanagawa_dragon.surface }}"
noteBorder = "{{ .theme.kanagawa_dragon.border }}"

[custom_theme.syntax]
keyword = "{{ .theme.kanagawa_dragon.yellow }}"
string = "{{ .theme.kanagawa_dragon.green }}"
comment = "{{ .theme.kanagawa_dragon.dim }}"
operator = "{{ .theme.kanagawa_dragon.orange }}"
variable = "{{ .theme.kanagawa_dragon.foreground }}"
{{- end }}
