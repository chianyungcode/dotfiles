{
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer {{ if eq .secrets.provider "onepassword" }}{{ onepasswordRead .secrets.ai_mcp.linear_apikey }}{{ end }}"
      }
    },
    "ticktick": {
      "url": "https://mcp.ticktick.com",
      "headers": {
        "Authorization": "Bearer {{ if eq .secrets.provider "onepassword" }}{{ onepasswordRead .secrets.ai_mcp.ticktick_apikey }}{{ end }}"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "{{ if eq .secrets.provider "onepassword" }}{{ onepasswordRead .secrets.ai_mcp.exa_apikey }}{{ end }}"
      }
    },
    "capacities": {
     "url": "https://api.capacities.io/mcp"
    }
  }
}
