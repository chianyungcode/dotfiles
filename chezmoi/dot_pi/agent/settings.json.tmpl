{{- $unified_theme := env "UNIFIED_THEME_CLI" -}}
{{- if eq $unified_theme "" }}{{ $unified_theme = .shell_env.common.UNIFIED_THEME_CLI }}{{ end -}}
{
  "lastChangelogVersion": "0.81.1",
  "theme": "{{ if eq $unified_theme "vesper" }}vesper{{ else }}catppuccin-mocha{{ end }}",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra"
  ],
  "packages": ["npm:@victor-software-house/pi-curated-themes", "npm:pi-zentui"]
}
