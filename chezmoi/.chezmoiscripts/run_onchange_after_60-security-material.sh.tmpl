{{- if eq .secrets.provider "onepassword" -}}
#!/usr/bin/env bash

PHASE="60-security-material"
{{ template "scripts/core.bash" . }}
fetch_onepassword_field() {
    local item_id=$1
    local primary_label=$2
    local alternate_label=$3
    local output_file=$4
    local key_label=$5

    if ! op item get "$item_id" --format json 2>/dev/null |
        jq -e -r -j \
            --arg primary "$primary_label" \
            --arg alternate "$alternate_label" '
                first(
                    .fields[]?
                    | select(
                        .label == $primary or
                        .label == $alternate
                    )
                    | .value
                    | select(type == "string" and length > 0)
                )
            ' 2>/dev/null >"$output_file"; then
        die "missing, empty, or unreadable $key_label key field"
    fi
    [[ -s "$output_file" ]] ||
        die "missing, empty, or unreadable $key_label key field"
}

install_server_keys() {
    local item_id=$1
    local private_key=$2
    local include_private=$3
    local public_key="$private_key.pub"
    local need_private=false
    local need_public=false

    if [[ -L "$private_key" || -L "$public_key" ]]; then
        die "refusing to write SSH key through symlink: ${private_key##*/}"
    fi

    if [[ "$include_private" == true && ! -f "$private_key" ]]; then
        need_private=true
    fi
    [[ -f "$public_key" ]] || need_public=true
    if [[ "$need_private" == false && "$need_public" == false ]]; then
        return 0
    fi

    require_command op
    require_command jq

    (
        local temporary_private=""
        local temporary_public=""
        cleanup_temporary_keys() {
            [[ -z "$temporary_private" ]] ||
                rm -f -- "$temporary_private"
            [[ -z "$temporary_public" ]] ||
                rm -f -- "$temporary_public"
        }
        trap cleanup_temporary_keys EXIT
        trap 'exit 1' HUP INT TERM
        umask 077

        if [[ "$need_private" == true ]]; then
            temporary_private=$(mktemp \
                "${private_key%/*}/.${private_key##*/}.tmp.XXXXXX") ||
                die "could not create temporary private key"
            fetch_onepassword_field \
                "$item_id" "privkey" "private key" \
                "$temporary_private" private
            chmod 0600 "$temporary_private"
        fi

        if [[ "$need_public" == true ]]; then
            temporary_public=$(mktemp \
                "${public_key%/*}/.${public_key##*/}.tmp.XXXXXX") ||
                die "could not create temporary public key"
            fetch_onepassword_field \
                "$item_id" "pubkey" "public key" \
                "$temporary_public" public
            chmod 0644 "$temporary_public"
        fi

        if [[ "$need_private" == true ]]; then
            mv "$temporary_private" "$private_key"
            temporary_private=""
        fi
        if [[ "$need_public" == true ]]; then
            mv "$temporary_public" "$public_key"
            temporary_public=""
        fi
    )
}

mkdir -p "{{ .directories.ssh_keys_dir }}"

{{ range .remote_servers -}}
install_server_keys \
    "{{ .op_id }}" \
    "{{ $.directories.ssh_keys_dir }}/{{ .name }}" \
    "{{ if .generate_public_key_only }}false{{ else }}true{{ end }}"
{{ end -}}
{{ end -}}
