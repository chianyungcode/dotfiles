{
	"[prisma]": {
		"editor.defaultFormatter": "Prisma.prisma"
	},

	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},

	"editor.accessibilitySupport": "off",
	"editor.autoClosingBrackets": "always",
	"editor.fontFamily": "MonoLisa",

	"editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'liga'",
	"editor.inlineSuggest.suppressSuggestions": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"editor.wordWrap": "on",
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": [
					"comment",
					"keyword.control.import.js",
					"keyword.control.export.js",
					"keyword.control.from.js",

					"storage.modifier",
					"storage.type.class",
					"storage.type.php",
					"keyword.other.new.php",
					"entity.other.attribute-name",
					"fenced_code.block.language.markdown"
				],
				"settings": {
					"fontStyle": "italic"
				}
			},
			{
				"scope": ["entity.name.type.class"],
				"settings": {
					"fontStyle": "bold"
				}
			},
			{
				"scope": ["entity.name.section.markdown"],
				"settings": {
					"fontStyle": "italic bold"
				}
			},
			{
				"scope": [
					"invalid",
					"keyword.operator",
					"constant.numeric.css",
					"keyword.other.unit.px.css",
					"constant.numeric.decimal.js",
					"constant.numeric.json",
					"comment.block",
					"entity.other.attribute-name.class.css"
				],
				"settings": {
					"fontStyle": ""
				}
			}
		]
	},

	"editor.cursorSmoothCaretAnimation": "on",
	"editor.smoothScrolling": true,
	"editor.cursorBlinking": "solid",

	"emmet.includeLanguages": {
		"postcss": "css"
	},
	"emmet.useInlineCompletions": true,
	"css.lint.unknownAtRules": "ignore",

	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,

	"javascript.updateImportsOnFileMove.enabled": "always",
	"typescript.updateImportsOnFileMove.enabled": "always",

	"prisma.showPrismaDataPlatformNotification": false,

	"supermaven.enable": {
		"*": false,
		"typescript": false
	},

	"tailwindCSS.experimental.classRegex": [
		["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
	],

	"terminal.external.osxExec": "Warp.app",
	"terminal.integrated.env.osx": {
		"FIG_NEW_SESSION": "1",
		"Q_NEW_SESSION": "1"
	},
	"terminal.integrated.fontFamily": "Geist Mono",

	"vscode-office.editorTheme": "Github Dark",

	"vsicons.dontShowNewVersionMessage": true,

	"window.titleBarStyle": "custom",
	"window.zoomLevel": 1,
	"workbench.colorTheme": "Minimal Kiwi",
	"workbench.iconTheme": "symbols",

	"console-ninja.featureSet": "Community",

	"cursor.cpp.disabledLanguages": ["postcss", "prisma", "html", "javascript"],
	"terminal.integrated.allowedLinkSchemes": [
		"file",
		"http",
		"https",
		"mailto",
		"vscode",
		"vscode-insiders",
		"docker-desktop"
	],

	"diffEditor.ignoreTrimWhitespace": false,
	"go.toolsManagement.autoUpdate": true,
	"gitlens.ai.experimental.model": "openai:gpt-4o-mini",

	"editor.scrollbar.vertical": "hidden",
	"editor.scrollbar.horizontal": "hidden",
	"workbench.statusBar.visible": true,
	"gitlens.ai.model": "openai:gpt-4o-mini"
}
